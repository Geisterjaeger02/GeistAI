# Copy to .env and adjust. Every value is optional.

# ---- network
GEIST_PORT=8765
GEIST_MDNS=1                      # announce _geistai._tcp so the T-Embed finds the server

# ---- speech recognition (faster-whisper)
WHISPER_MODEL=small               # tiny | base | small | medium | large-v3 (bigger = better + slower)
WHISPER_DEVICE=auto               # auto | cpu | cuda
WHISPER_COMPUTE=auto              # auto = float16 on an NVIDIA GPU, int8 on the CPU
# NVIDIA GPU: pip install -r requirements-gpu.txt  - then large-v3-turbo is fast and very accurate
# Languages the speech recognition may detect (fewer = fewer mix-ups). Default: every language
# with a voice: de en es fr it pt nl pl tr ru uk cs sk sv da no fi hu ro el ca sr ar fa hi zh vi id
# ALLOWED_LANGUAGES=de,en,es

# ---- language model
LLM_BACKEND=ollama                # ollama | openai  (LM Studio, llama.cpp server, vLLM ...)
LLM_URL=http://localhost:11434    # LM Studio: http://localhost:1234
LLM_MODEL=gemma3:4b               # any multilingual chat model you have pulled
LLM_TEMPERATURE=0.6
LLM_MAX_TOKENS=220
LLM_KEEP_ALIVE=2h                 # keep the model loaded this long after the last question
HISTORY_TURNS=6
ASSISTANT_NAME=GeistAI
GEIST_TIMEZONE=Europe/Berlin

# ---- internet lookups (weather, web + news search, Wikipedia; no API keys needed)
INTERNET=1                        # 0 = offline only
HOME_LOCATION=                    # your town, for "what's the weather like?" e.g. Bordesholm
INTERNET_TIMEOUT=8

# ---- optional: ChatGPT (switch per device: Settings -> AI model)
# Get a key at https://platform.openai.com/api-keys (pay per use, a few cents per day of chatting).
# Any OpenAI-compatible service works too: set OPENAI_URL (e.g. https://api.groq.com/openai).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini         # fast and cheap; gpt-4.1 / gpt-5-mini are smarter but slower
# OPENAI_URL=https://api.openai.com

# ---- voices (Piper)
VOICES_DIR=voices
TTS_LENGTH_SCALE=1.0              # >1 speaks slower
SPEAK_ON_PC=0                     # 1 = also play the answers on this computer's speakers
AUTO_DOWNLOAD_VOICES=1            # fetch a voice the first time you speak a new language
# VOICE_DE=de_DE-thorsten-medium
# VOICE_EN=en_US-lessac-medium
# VOICE_ES=es_ES-davefx-medium
